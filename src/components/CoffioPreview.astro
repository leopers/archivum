<figure class="coffio-demo" data-coffio-demo>
  <figcaption>
    <span>Interface preview</span>
    <span>Interactive demonstration · no device connected</span>
  </figcaption>

  <div class="browser-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span>coffio.local</span>
  </div>

  <div class="coffio-screen">
    <div class="coffio-card">
      <div class="mascot-wrap">
        <img
          src="https://raw.githubusercontent.com/leopers/coffio/main/data/cat.jpg"
          alt="Coffio cat mascot"
          loading="lazy"
        />
      </div>

      <h3>☕ Coffio Café</h3>
      <p class="subtitle">Start your day with a warm cup ~</p>

      <button class="primary" type="button" data-action="brew">
        ✨ Make Coffee Now
      </button>

      <div class="scheduler">
        <label>
          <span>⏰ Schedule Brew</span>
          <input type="time" data-time value="07:30" />
        </label>
        <button class="secondary" type="button" data-action="schedule">
          Set Time 💖
        </button>
      </div>

      <button class="cancel" type="button" data-action="cancel">
        Cancel Brew
      </button>
      <p class="status" aria-live="polite" data-status>
        ~ Awaiting your command ~
      </p>
    </div>
  </div>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-coffio-demo]")
    .forEach((demo) => {
      const status = demo.querySelector<HTMLElement>("[data-status]");
      const time = demo.querySelector<HTMLInputElement>("[data-time]");

      demo
        .querySelector('[data-action="brew"]')
        ?.addEventListener("click", () => {
          if (status) status.textContent = "☕ Brewing... demo started.";
        });

      demo
        .querySelector('[data-action="schedule"]')
        ?.addEventListener("click", () => {
          if (status)
            status.textContent = time?.value
              ? `🕐 Coffee scheduled for ${time.value}.`
              : "📅 Choose a time first.";
        });

      demo
        .querySelector('[data-action="cancel"]')
        ?.addEventListener("click", () => {
          if (status) status.textContent = "🛑 Brew canceled.";
        });
    });
</script>

