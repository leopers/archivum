<figure class="living-system" aria-hidden="true">
  <canvas class="living-canvas"></canvas>
</figure>

<script>
  type Point = {
    x: number;
    y: number;
    parent: number;
    depth: number;
    terminal?: boolean;
  };

  const nodes: Point[] = [
    { x: 0.5, y: 0.95, parent: -1, depth: 0 },
    { x: 0.49, y: 0.78, parent: 0, depth: 1 },
    { x: 0.52, y: 0.61, parent: 1, depth: 2 },
    { x: 0.48, y: 0.44, parent: 2, depth: 3 },
    { x: 0.51, y: 0.27, parent: 3, depth: 4 },
    { x: 0.47, y: 0.09, parent: 4, depth: 5, terminal: true },
    { x: 0.27, y: 0.68, parent: 1, depth: 2 },
    { x: 0.12, y: 0.55, parent: 6, depth: 3, terminal: true },
    { x: 0.73, y: 0.68, parent: 2, depth: 3 },
    { x: 0.88, y: 0.56, parent: 8, depth: 4, terminal: true },
    { x: 0.28, y: 0.39, parent: 3, depth: 4 },
    { x: 0.13, y: 0.25, parent: 10, depth: 5, terminal: true },
    { x: 0.7, y: 0.34, parent: 4, depth: 5 },
    { x: 0.86, y: 0.21, parent: 12, depth: 6, terminal: true },
    { x: 0.64, y: 0.12, parent: 4, depth: 5, terminal: true },
  ];

  document
    .querySelectorAll<HTMLCanvasElement>(".living-canvas")
    .forEach((canvas) => {
      const context = canvas.getContext("2d");
      const host = canvas.closest<HTMLElement>(".living-system");
      if (!context || !host) return;

      let width = 0;
      let height = 0;
      let frame = 0;
      let visible = true;
      const startTime = performance.now();
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const color = (name: string) =>
        getComputedStyle(document.documentElement)
          .getPropertyValue(name)
          .trim();

      const resize = () => {
        const box = host.getBoundingClientRect();
        const dpr = Math.min(devicePixelRatio || 1, 2);
        width = box.width;
        height = box.height;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        draw(reducedMotion ? 7200 : performance.now());
      };

      const position = (node: Point, time: number) => {
        const sway =
          node.depth === 0
            ? 0
            : Math.sin(time * 0.00045 + node.depth * 1.31 + node.x * 8) *
              (2 + node.depth * 0.62);
        return { x: node.x * width + sway, y: node.y * height };
      };

      const curve = (
        from: { x: number; y: number },
        to: { x: number; y: number },
      ) => {
        const dy = to.y - from.y;
        const dx = to.x - from.x;
        context.beginPath();
        context.moveTo(from.x, from.y);
        context.bezierCurveTo(
          from.x + dx * 0.18,
          from.y + dy * 0.42,
          to.x - dx * 0.28,
          to.y - dy * 0.35,
          to.x,
          to.y,
        );
      };

      const curvePoint = (
        a: { x: number; y: number },
        b: { x: number; y: number },
        t: number,
      ) => {
        const dy = b.y - a.y;
        const dx = b.x - a.x;
        const c1 = { x: a.x + dx * 0.18, y: a.y + dy * 0.42 };
        const c2 = { x: b.x - dx * 0.28, y: b.y - dy * 0.35 };
        const u = 1 - t;
        return {
          x:
            u ** 3 * a.x +
            3 * u ** 2 * t * c1.x +
            3 * u * t ** 2 * c2.x +
            t ** 3 * b.x,
          y:
            u ** 3 * a.y +
            3 * u ** 2 * t * c1.y +
            3 * u * t ** 2 * c2.y +
            t ** 3 * b.y,
        };
      };

      const draw = (time: number) => {
        context.clearRect(0, 0, width, height);
        const green = color("--accent");
        const purple = color("--violet");
        const line = color("--line");
        const paper = color("--paper");

        // A precise substrate: quiet circuit traces behind the growing structure.
        context.save();
        context.strokeStyle = line;
        context.fillStyle = purple;
        context.lineWidth = 1;
        context.globalAlpha = 0.34;
        const traces = [
          [0.03, 0.22, 0.22, 0.22, 0.22, 0.34, 0.35, 0.34],
          [0.66, 0.14, 0.79, 0.14, 0.79, 0.31, 0.96, 0.31],
          [0.04, 0.78, 0.18, 0.78, 0.18, 0.64, 0.31, 0.64],
          [0.69, 0.76, 0.83, 0.76, 0.83, 0.62, 0.97, 0.62],
        ];
        traces.forEach((trace, index) => {
          context.beginPath();
          context.moveTo(trace[0] * width, trace[1] * height);
          for (let i = 2; i < trace.length; i += 2)
            context.lineTo(trace[i] * width, trace[i + 1] * height);
          context.stroke();
          const phase = (time * 0.00008 + index * 0.23) % 1;
          const segment = Math.min(Math.floor(phase * 3), 2);
          const local = phase * 3 - segment;
          const x =
            (trace[segment * 2] +
              (trace[segment * 2 + 2] - trace[segment * 2]) * local) *
            width;
          const y =
            (trace[segment * 2 + 1] +
              (trace[segment * 2 + 3] - trace[segment * 2 + 1]) * local) *
            height;
          context.beginPath();
          context.arc(x, y, 2.2, 0, Math.PI * 2);
          context.fill();
        });
        context.restore();

        const elapsed = reducedMotion
          ? 99999
          : Math.max(0, (time - startTime) % 18000);
        nodes.slice(1).forEach((node, index) => {
          const parent = nodes[node.parent];
          const from = position(parent, time);
          const to = position(node, time);
          const growth = Math.min(
            1,
            Math.max(0, (elapsed - index * 145 - 220) / 1150),
          );
          if (growth <= 0) return;

          context.save();
          context.strokeStyle = green;
          context.lineWidth = Math.max(1, 3.25 - node.depth * 0.34);
          context.lineCap = "round";
          context.globalAlpha = 0.48 + growth * 0.4;
          curve(from, to);
          context.setLineDash([1000]);
          context.lineDashOffset = 1000 * (1 - growth);
          context.stroke();
          context.restore();

          if (growth > 0.92) {
            context.save();
            context.fillStyle = paper;
            context.strokeStyle = node.terminal ? green : purple;
            context.lineWidth = 1.2;
            context.beginPath();
            context.arc(to.x, to.y, node.terminal ? 3.6 : 2.5, 0, Math.PI * 2);
            context.fill();
            context.stroke();
            context.restore();
          }

          if (node.terminal && growth > 0.96) {
            const angle = Math.atan2(to.y - from.y, to.x - from.x);
            const breathe = 1 + Math.sin(time * 0.0012 + index) * 0.08;
            context.save();
            context.translate(to.x, to.y);
            context.rotate(angle + (index % 2 ? 0.42 : -0.42));
            context.scale(breathe, breathe);
            context.fillStyle = green;
            context.globalAlpha = 0.13;
            context.beginPath();
            context.ellipse(10, 0, 12, 4.8, 0, 0, Math.PI * 2);
            context.fill();
            context.strokeStyle = green;
            context.globalAlpha = 0.68;
            context.beginPath();
            context.moveTo(0, 0);
            context.quadraticCurveTo(10, -8, 22, 0);
            context.quadraticCurveTo(10, 8, 0, 0);
            context.stroke();
            context.restore();
          }
        });

        // Electrical impulses use the plant itself as their conductive network.
        if (elapsed > 2600) {
          [4, 7, 9, 11, 13, 14].forEach((nodeIndex, pulseIndex) => {
            const node = nodes[nodeIndex];
            const parent = nodes[node.parent];
            const a = position(parent, time);
            const b = position(node, time);
            const phase = (time * 0.00019 + pulseIndex * 0.17) % 1;
            const point = curvePoint(a, b, phase);
            context.save();
            context.fillStyle = purple;
            context.shadowColor = purple;
            context.shadowBlur = 8;
            context.beginPath();
            context.arc(point.x, point.y, 2.2, 0, Math.PI * 2);
            context.fill();
            context.restore();
          });
        }
      };

      const loop = (time: number) => {
        if (visible) draw(time);
        frame = requestAnimationFrame(loop);
      };

      new ResizeObserver(resize).observe(host);
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), {
        threshold: 0.05,
      }).observe(host);
      new MutationObserver(() =>
        draw(reducedMotion ? 7200 : performance.now()),
      ).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      resize();
      if (!reducedMotion) frame = requestAnimationFrame(loop);
      addEventListener("pagehide", () => cancelAnimationFrame(frame), {
        once: true,
      });
    });
</script>

<style>
  .living-system {
    position: relative;
    width: 100%;
    min-width: 220px;
    height: 285px;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
  }
  .living-system::before,
  .living-system::after {
    content: "";
    position: absolute;
    pointer-events: none;
    z-index: -1;
  }
  .living-system::before {
    inset: 7% 2% 13%;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.22;
    mask-image: radial-gradient(ellipse, #000 10%, transparent 72%);
  }
  .living-system::after {
    width: 62%;
    aspect-ratio: 1;
    left: 19%;
    top: 4%;
    border: 1px solid color-mix(in srgb, var(--violet) 22%, transparent);
    border-radius: 50%;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  figcaption {
    position: absolute;
    right: 5px;
    bottom: 4px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.57rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  figcaption span {
    width: 16px;
    height: 1px;
    background: var(--violet);
  }
  @media (max-width: 900px) {
    .living-system {
      height: 225px;
      max-width: 520px;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .living-system::after {
      opacity: 0.65;
    }
  }
</style>
