---
const { locale = "en" } = Astro.props;
const fr = locale === "fr";

const metrics = [
  {
    name: fr ? "Précision par pixel" : "Pixel accuracy",
    methods: [
      { name: "GrabCut", mean: 0.76, std: 0.17, learned: false },
      { name: "U-Net", mean: 0.87, std: 0.08, learned: true },
    ],
  },
  {
    name: "Intersection over Union",
    methods: [
      { name: "GrabCut", mean: 0.58, std: 0.23, learned: false },
      { name: "U-Net", mean: 0.74, std: 0.14, learned: true },
    ],
  },
];
---

<figure class="results-figure" aria-labelledby={`results-title-${locale}`}>
  <figcaption>
    <span class="eyebrow"
      >{fr ? "Résultats quantitatifs" : "Quantitative results"}</span
    >
    <h3 id={`results-title-${locale}`}>
      {
        fr
          ? "Performance sur le jeu de validation"
          : "Validation-set performance"
      }
    </h3>
    <p>
      {
        fr
          ? "Moyenne ± écart-type calculés image par image. Une valeur plus élevée est meilleure."
          : "Per-image mean ± standard deviation. Higher values are better."
      }
    </p>
  </figcaption>

  <div class="metrics">
    {
      metrics.map((metric) => (
        <section class="metric">
          <h4>{metric.name}</h4>
          {metric.methods.map((method) => (
            <div class="result-row">
              <div class="result-label">
                <strong>{method.name}</strong>
                <span>
                  {method.mean.toFixed(2)}{" "}
                  <small>± {method.std.toFixed(2)}</small>
                </span>
              </div>
              <div
                class:list={["result-track", { learned: method.learned }]}
                role="progressbar"
                aria-label={`${method.name}: ${method.mean.toFixed(2)}`}
                aria-valuemin="0"
                aria-valuemax="1"
                aria-valuenow={method.mean}
              >
                <span style={`width:${method.mean * 100}%`} />
              </div>
            </div>
          ))}
        </section>
      ))
    }
  </div>

  <div class="result-summary">
    <div>
      <strong>+11 pp</strong>
      <span>{fr ? "précision" : "accuracy"}</span>
    </div>
    <div>
      <strong>+16 pp</strong>
      <span>IoU</span>
    </div>
    <div>
      <strong>−0.09</strong>
      <span>{fr ? "dispersion IoU" : "IoU spread"}</span>
    </div>
  </div>
</figure>

<style>
  .results-figure {
    margin: 2.8rem 0 3.2rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, var(--ink));
    font-family: system-ui, sans-serif;
  }
  figcaption {
    padding: 1.5rem 1.6rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  figcaption h3 {
    margin: 0.45rem 0 0.35rem;
    font-family: Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
  }
  figcaption p {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .metric {
    padding: 1.5rem 1.6rem 1.7rem;
  }
  .metric + .metric {
    border-left: 1px solid var(--line);
  }
  .metric h4 {
    margin: 0 0 1.25rem;
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 500;
  }
  .result-row + .result-row {
    margin-top: 1.1rem;
  }
  .result-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.42rem;
    font-size: 0.75rem;
  }
  .result-label strong {
    font-weight: 600;
  }
  .result-label span {
    font-variant-numeric: tabular-nums;
  }
  .result-label small {
    color: var(--muted);
    font-size: inherit;
  }
  .result-track {
    height: 0.42rem;
    overflow: hidden;
    background: var(--line);
  }
  .result-track span {
    display: block;
    height: 100%;
    background: var(--muted);
  }
  .result-track.learned span {
    background: var(--green);
  }
  .result-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .result-summary div {
    padding: 1rem 1.25rem;
    text-align: center;
  }
  .result-summary div + div {
    border-left: 1px solid var(--line);
  }
  .result-summary strong,
  .result-summary span {
    display: block;
  }
  .result-summary strong {
    color: var(--green);
    font-family: Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .result-summary span {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (max-width: 620px) {
    .metrics {
      grid-template-columns: 1fr;
    }
    .metric + .metric {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .result-summary {
      grid-template-columns: 1fr;
    }
    .result-summary div + div {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
