---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const all = [
  ...(await getCollection("writing", ({ data }) => !data.draft)),
  ...(await getCollection("projects")),
  ...(await getCollection("music", ({ data }) => !data.draft)),
];
const grouped = new Map<string, typeof all>();
all.forEach((entry) =>
  entry.data.topics.forEach((topic) =>
    grouped.set(topic, [...(grouped.get(topic) || []), entry]),
  ),
);
const entryHref = (entry: (typeof all)[number]) =>
  `/${entry.collection === "projects" ? "projects" : entry.collection === "music" ? "music" : "writing"}/${entry.id}`;
const entryType = (entry: (typeof all)[number]) =>
  entry.collection === "projects"
    ? "Project"
    : entry.collection === "music"
      ? "Music"
      : "Essay";
const descriptions: Record<string, string> = {
  Probability: "Probability and statistics.",
  Optimization: "Optimization methods and geometry.",
  "Machine Learning": "Learning methods and models.",
  Algorithms: "Algorithms and computation.",
  "Computer Vision": "Image processing and visual learning.",
  Simulation: "Numerical and Monte Carlo experiments.",
  "Embedded Systems": "Hardware, firmware, and physical computing.",
  "Internet of Things": "Connected devices and networked interfaces.",
  "C++": "Systems and embedded programming.",
  PyTorch: "Neural-network experiments and implementations.",
};
---

<BaseLayout title="Topics — Leonardo Dias"
  ><header class="page-head">
    <div class="eyebrow">Index</div><h1>Topics</h1><p>
      Notes and projects grouped by subject.
    </p>
  </header><div class="topic-grid">
    {
      [...grouped.entries()].sort().map(([topic, entries]) => (
        <section
          class="topic-card"
          id={topic.toLowerCase().replaceAll(" ", "-")}
        >
          <>
            <h2>{topic}</h2>
            <p>{descriptions[topic] || "Notes and projects."}</p>
            <span class="tag">
              {entries.length} {entries.length === 1 ? "entry" : "entries"}
            </span>
            <ul class="topic-entries">
              {entries.map((entry) => (
                <li>
                  <a href={entryHref(entry)}>
                    <span>{entry.data.title}</span>
                    <small>{entryType(entry)} →</small>
                  </a>
                </li>
              ))}
            </ul>
          </>
        </section>
      ))
    }
  </div></BaseLayout
>
