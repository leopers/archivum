---
import { getCollection } from "astro:content";
import LocalizedSitePage from "../../components/LocalizedSitePage.astro";
import type { Locale } from "../../i18n/ui";

export async function getStaticPaths() {
  const writing = await getCollection("writing", ({ data }) => !data.draft);
  const projects = await getCollection("projects");
  const music = await getCollection("music", ({ data }) => !data.draft);
  const pages = [undefined, "writing", "projects", "topics", "music", "about"];
  const details = [
    ...writing.map((entry) => `writing/${entry.id}`),
    ...projects.map((entry) => `projects/${entry.id}`),
    ...music.map((entry) => `music/${entry.id}`),
  ];
  return (["fr"] as const).flatMap((lang) =>
    [...pages, ...details].map((slug) => ({ params: { lang, slug } })),
  );
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug || "";
---

<LocalizedSitePage locale={locale} slug={slug} />
